# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_queue

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google Sign-In (OAuth 2.0 Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=replace_with_your_google_oauth_client_id

# CORS - the frontend origin allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Admin seed script (npm run seed:admin) - not read at server runtime
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_temporary_password
