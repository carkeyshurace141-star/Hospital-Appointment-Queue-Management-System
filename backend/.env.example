# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google Sign-In (OAuth 2.0 Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# CORS - the frontend origin allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Admin seed script (npm run seed:admin) - not read at server runtime
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@mediqueue.com
ADMIN_PASSWORD=

# Outgoing mail (appointment confirmation emails) - leave blank to skip
# sending and just log a warning. For Gmail, use an App Password, not your
# regular password: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=MediQueue <no-reply@mediqueue.com>
